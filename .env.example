# Mobile (.env — never commit real values)
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_ENV=development
# dummy = fake local auth while building (default) | api = real backend auth
EXPO_PUBLIC_AUTH_MODE=dummy
# Managed Neon Auth base URL (public config — same value as backend NEON_AUTH_BASE_URL).
# Only used when EXPO_PUBLIC_AUTH_MODE=api.
EXPO_PUBLIC_NEON_AUTH_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.tech/neondb/auth
