# Backend (.env — never commit real values)
PORT=4000
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/roomie?sslmode=require
# Managed Neon Auth base URL (from Neon Console → Auth). Backend verifies its
# EdDSA JWTs via <base>/.well-known/jwks.json; issuer must be the URL origin.
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.tech/neondb/auth
# Optional: object storage + push
STORAGE_ENDPOINT=
STORAGE_BUCKET=roomie-photos
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
EXPO_ACCESS_TOKEN=
ALLOW_SEED=false
